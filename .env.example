# Copy to .env and fill in real values. Never commit the real .env file.

# --- Secrets ---
# Fernet key for encrypting connection tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Database ---
# Uses your existing local MySQL server (see README for the one-time
# CREATE DATABASE/CREATE USER setup). DB_USER/DB_PASSWORD are also read
# directly by docker-compose.yml to build the container's DATABASE_URL
# against host.docker.internal, since MySQL itself isn't containerized here.
DB_USER=sentinel
DB_PASSWORD=sentinel
DATABASE_URL=mysql+pymysql://sentinel:sentinel@localhost:3306/sentinel

# --- Broker (overridden by docker-compose.yml's redis service hostname when run via compose) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
MIN_FINDING_CONFIDENCE=0.55
INGESTION_POLL_INTERVAL_SECONDS=21600
