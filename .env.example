# Copy to .env and fill in real values. Never commit the real .env file.

# --- Secrets ---
# Fernet key for encrypting connection tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Auth ---
# Signs session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# "console" (default) logs OTP codes instead of emailing them - works with
# no setup. Switch to "smtp" once SMTP_* below is filled in.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sentinel.local

# Optional - Google/Microsoft sign-in. Leave blank to run without them;
# those login routes return a clear "not configured" error until set.
#   Google:    https://console.cloud.google.com/apis/credentials
#              redirect URI: {BACKEND_BASE_URL}/auth/google/callback
#   Microsoft: https://portal.azure.com -> App registrations
#              redirect URI: {BACKEND_BASE_URL}/auth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# --- Database ---
# Uses your existing local MySQL server (see README for the one-time
# CREATE DATABASE/CREATE USER setup). DB_USER/DB_PASSWORD are also read
# directly by docker-compose.yml to build the container's DATABASE_URL
# against host.docker.internal, since MySQL itself isn't containerized here.
DB_USER=sentinel
DB_PASSWORD=sentinel
DATABASE_URL=mysql+pymysql://sentinel:sentinel@localhost:3306/sentinel

# --- Broker (overridden by docker-compose.yml's redis service hostname when run via compose) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
MIN_FINDING_CONFIDENCE=0.55
INGESTION_POLL_INTERVAL_SECONDS=21600
